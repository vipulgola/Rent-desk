<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="4dp"
        android:text="@string/address_dashboard_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">
        <ImageView
            android:layout_width="238dp"
            android:layout_height="86dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/ill_address_neighborhood" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:padding="4dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RentDesk.AddressSummaryCard"
                android:layout_marginEnd="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="66dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_address_circle"
                        android:backgroundTint="@color/address_location_background"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        app:srcCompat="@drawable/ic_location_24"
                        app:tint="@color/address_location_icon" />
                    <TextView
                        android:id="@+id/tv_location_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="2 Locations" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RentDesk.AddressSummaryCard"
                android:layout_marginStart="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="66dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_address_circle"
                        android:backgroundTint="@color/address_property_background"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        app:srcCompat="@drawable/ic_home_24"
                        app:tint="@color/address_property_icon" />
                    <TextView
                        android:id="@+id/tv_property_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="3 Properties" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:drawablePadding="16dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:padding="24dp"
        android:text="@string/address_dashboard_empty"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_location_24" />
</LinearLayout>
